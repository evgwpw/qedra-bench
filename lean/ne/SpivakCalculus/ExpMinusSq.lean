import SpivakCalculus.RatFuncDeriv

/-!
# e^{−x²} has no elementary primitive — класс `erf`

Зеркало `SpivakCalculus/ExpSq.lean` (`θ′ = −2x·θ` вместо `+2x·θ`, `θ` играет роль `e^{−x²}`),
но база `k(x)` (`x′ = 1`, `ratFunc_riccati`, леммы об отсутствии рациональных решений) взята из
`SpivakCalculus/RatFuncDeriv.lean` и от знака не зависит. Производная работа от
`Chapter19Liouville.lean` проекта [stormj-UH/spivak-lean](https://github.com/stormj-UH/spivak-lean)
(Apache-2.0); уведомление — `THIRD-PARTY-NOTICES.md`.

**Важно:** этот файл и `ExpSq.lean` задают разные дифференциалы на одном носителе
`RatFunc (RatFunc k)` — импортировать их в один файл нельзя.

Что даётся: `exp_neg_sq_not_elementary` (у `e^{−x²}` нет элементарной первообразной),
`exp_neg_sq_rat_risch` / `exp_neg_sq_rat_not_elementary` (класс `r(x)·e^{−x²}`) и
`exp_neg_sq_simple_pole_not_elementary` (простой полюс `A/(x−a)`, т. е. `∫ e^{−x²}/(x−a) dx`).
-/

set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option maxHeartbeats 1000000
set_option linter.style.haveILetI false

open Polynomial Differential Spivak.Liouville Spivak.NeGen
open scoped Differential

namespace Spivak.ExpNegSq

/-! ## The differential field `k(x)(θ)`, `x' = 1`, `θ' = -2xθ` -/

/-- The field `k(x)(θ)` of rational functions in `θ` over `k(x)`, which will carry the
derivation with `x' = 1` and `θ' = -2xθ`: the differential field generated by `e^{-x²}`. -/
def Gauss (k : Type*) [Field k] : Type _ := RatFunc (RatFunc k)

namespace Gauss

variable (k : Type*) [Field k]

noncomputable instance : Field (Gauss k) := inferInstanceAs (Field (RatFunc (RatFunc k)))

noncomputable instance algPoly : Algebra (RatFunc k)[X] (Gauss k) :=
  inferInstanceAs (Algebra (RatFunc k)[X] (RatFunc (RatFunc k)))

instance : IsFractionRing (RatFunc k)[X] (Gauss k) :=
  inferInstanceAs (IsFractionRing (RatFunc k)[X] (RatFunc (RatFunc k)))

noncomputable instance algBase : Algebra (RatFunc k) (Gauss k) :=
  inferInstanceAs (Algebra (RatFunc k) (RatFunc (RatFunc k)))

instance : IsScalarTower (RatFunc k) (RatFunc k)[X] (Gauss k) :=
  inferInstanceAs (IsScalarTower (RatFunc k) (RatFunc k)[X] (RatFunc (RatFunc k)))

/-- Многочлен `-2x` — `p′` для `p = -x²` (тот же коэффициент, что в `θ′ = -2x·θ`). -/
noncomputable def thetaCoef : k[X] := C (-2 : k) * X

lemma thetaCoef_eq :
    (algebraMap k[X] (RatFunc k) (thetaCoef k) : RatFunc k) = -2 * RatFunc.X := by
  unfold thetaCoef
  have hC : (C (-2 : k) : k[X]) = -(2 : k[X]) := by rw [map_neg, map_ofNat]
  rw [hC, map_mul, map_neg, map_ofNat, RatFunc.algebraMap_X]

/-- The polynomial `-2x · θ` prescribing `θ'`. -/
noncomputable def thetaDeriv : (RatFunc k)[X] := C (-2 * RatFunc.X) * X

/-- The derivation on `k(x)(θ)`: `d/dx` on coefficients, and `θ' = -2xθ`. -/
noncomputable instance : Differential (Gauss k) :=
  ⟨fracDeriv (implicitDeriv (thetaDeriv k))⟩

/-- The element `x ∈ k(x)(θ)`. -/
noncomputable def x : Gauss k := algebraMap (RatFunc k) (Gauss k) RatFunc.X

/-- The element `θ ∈ k(x)(θ)`, standing for `e^{-x²}`. -/
noncomputable def θ : Gauss k := algebraMap (RatFunc k)[X] (Gauss k) X

lemma deriv_poly (P : (RatFunc k)[X]) :
    (algebraMap (RatFunc k)[X] (Gauss k) P)′ =
      algebraMap (RatFunc k)[X] (Gauss k) (implicitDeriv (thetaDeriv k) P) :=
  fracDeriv_algebraMap _ P

lemma algebraMap_base (e : RatFunc k) :
    algebraMap (RatFunc k) (Gauss k) e = algebraMap (RatFunc k)[X] (Gauss k) (C e) := by
  rw [IsScalarTower.algebraMap_apply (RatFunc k) (RatFunc k)[X] (Gauss k), Polynomial.algebraMap_eq]

instance : DifferentialAlgebra (RatFunc k) (Gauss k) where
  deriv_algebraMap e := by
    rw [algebraMap_base, deriv_poly, implicitDeriv_C, ← algebraMap_base]

/-- `x' = 1`. -/
theorem deriv_x : (x k)′ = 1 := by
  unfold x
  rw [deriv_algebraMap, ratFunc_deriv_X, map_one]

/-- `θ' = -2xθ`. -/
theorem deriv_θ : (θ k)′ = -2 * x k * θ k := by
  unfold θ x
  rw [deriv_poly, implicitDeriv_X, thetaDeriv, map_mul, ← algebraMap_base, map_mul, map_neg,
    map_ofNat]

lemma deriv_θ' : (θ k)′ = algebraMap (RatFunc k) (Gauss k) (-2 * RatFunc.X) * θ k := by
  rw [deriv_θ, map_mul, map_neg, map_ofNat]
  rfl

lemma aeval_θ (P : (RatFunc k)[X]) : aeval (θ k) P = algebraMap (RatFunc k)[X] (Gauss k) P := by
  unfold θ
  rw [aeval_algebraMap_apply, aeval_X_left_apply]

/-- `θ` is transcendental over `k(x)`. -/
theorem θ_transcendental : Transcendental (RatFunc k) (θ k) := by
  rw [transcendental_iff_injective]
  intro P Q h
  rw [aeval_θ, aeval_θ] at h
  exact IsFractionRing.injective _ _ h

lemma isRatIn (z : Gauss k) : IsRatIn (RatFunc k) (θ k) z := by
  obtain ⟨P, Q, -, rfl⟩ := exists_frac (R := (RatFunc k)[X]) z
  exact ⟨P, Q, by rw [aeval_θ, aeval_θ]⟩

variable [CharZero k]

lemma thetaCoef_deg : 0 < (thetaCoef k).natDegree := by
  unfold thetaCoef
  rw [natDegree_C_mul (by norm_num), natDegree_X]
  norm_num

/-- Every constant of `k(x)(θ)` lies in `k(x)`. -/
theorem constants_mem_base (z : Gauss k) (hz : z′ = 0) :
    z ∈ (algebraMap (RatFunc k) (Gauss k)).range :=
  exp_constants (θ_transcendental k) (deriv_θ' k) (isRatIn k)
    (fun j hj g hg => ratFunc_no_exp_solution_gen (thetaCoef k) (thetaCoef_deg k) j hj g
      (by rwa [← thetaCoef_eq k] at hg)) z hz

instance : Differential.ContainConstants (RatFunc k) (Gauss k) :=
  ⟨fun h => constants_mem_base k _ h⟩

/-- **The constants of `k(x)(θ)` are exactly `k`.** -/
theorem constants (z : Gauss k) :
    z′ = 0 ↔ ∃ c : k, z = algebraMap (RatFunc k) (Gauss k) (algebraMap k (RatFunc k) c) := by
  constructor
  · intro hz
    obtain ⟨f, rfl⟩ := constants_mem_base k z hz
    obtain ⟨c, rfl⟩ := (ratFunc_constants f).mp (deriv_eq_zero_of_algebraMap hz)
    exact ⟨c, rfl⟩
  · rintro ⟨c, rfl⟩
    rw [deriv_algebraMap, (ratFunc_constants _).mpr ⟨c, rfl⟩, map_zero]

instance : CharZero (Gauss k) :=
  haveI : CharZero (RatFunc k) :=
    charZero_of_injective_algebraMap (algebraMap k (RatFunc k)).injective
  charZero_of_injective_algebraMap (algebraMap (RatFunc k) (Gauss k)).injective

/-- `θ` is not of the logarithmic form: comparing coefficients of `θ` gives `f ∈ k(x)`
with `f' - 2xf = 1`, impossible (`ratFunc_no_solution_one_gen`). -/
theorem θ_not_hasLogForm : ¬ HasLogForm (θ k) := by
  classical
  rintro ⟨n, c, u, v, hc, h⟩
  have ht := θ_transcendental k
  set b : RatFunc k := -2 * RatFunc.X with hb_def
  have hb : ∀ j : ℕ, 0 < j → ∀ z : RatFunc k, z′ = j * b * z → z = 0 :=
    fun j hj z hz => ratFunc_no_exp_solution_gen (thetaCoef k) (thetaCoef_deg k) (j : ℤ)
      (by omega) z (by rw [hb_def, ← thetaCoef_eq k] at hz; simpa using hz)
  have ha : ∀ p : (RatFunc k)[X], ∀ (_ : p.Monic) (hi : Irreducible p), p ≠ X →
      θ k ∈ locRing ht hi.prime := fun p _ hi _ => by
    have := aeval_mem_locRing ht hi.prime X
    rwa [aeval_X] at this
  obtain ⟨γ, e, δ, P, m, hγ, hδ, hvP, h'⟩ := exp_reduce ht (deriv_θ' k) (constants_mem_base k)
    hb c u v (θ k) hc (fun i => isRatIn k _) (isRatIn k v) ha h
  set β := ∑ i, γ i * logDeriv (e i) + δ * b with hβ
  have hvβ : v′ = θ k - algebraMap (RatFunc k) (Gauss k) β := by
    rw [hβ, map_add, map_sum, hb_def]
    conv_rhs => rw [h']
    ring
  have hid := exp_deriv_identity ht (deriv_θ' k) P m
  rw [← hvP, hvβ] at hid
  have hpoly : X ^ (m + 1) - C β * X ^ m + C (m * b) * P = implicitDeriv (C b * X) P := by
    apply aeval_inj_of_transcendental ht
    rw [← hid]
    simp only [map_add, map_sub, map_mul, map_pow, aeval_X, aeval_C, map_natCast, hb_def]
    ring
  have hck := congrArg (fun q => q.coeff (m + 1)) hpoly
  simp only [coeff_add, coeff_sub, coeff_C_mul, coeff_X_pow, coeff_implicitDeriv_CX, ite_true,
    show m + 1 ≠ m from by omega, ite_false] at hck
  push_cast at hck
  -- `linear_combination` в этом пине здесь даёт лишний множитель 2 — считаем вручную
  have hfin : (P.coeff (m + 1))′ + b * (P.coeff (m + 1)) = 1 := by
    have h1 : (P.coeff (m + 1))′ + b * ((m : RatFunc k) + 1) * (P.coeff (m + 1)) =
        1 + (m : RatFunc k) * b * (P.coeff (m + 1)) := by
      simpa using hck.symm
    calc (P.coeff (m + 1))′ + b * (P.coeff (m + 1))
        = (P.coeff (m + 1))′ + b * ((m : RatFunc k) + 1) * (P.coeff (m + 1)) -
            b * (m : RatFunc k) * (P.coeff (m + 1)) := by ring
      _ = (1 + (m : RatFunc k) * b * (P.coeff (m + 1))) -
            b * (m : RatFunc k) * (P.coeff (m + 1)) := by rw [h1]
      _ = 1 := by ring
  exact ratFunc_no_solution_one_gen (thetaCoef k) (thetaCoef_deg k) (P.coeff (m + 1))
    (by simpa [hb_def, ← thetaCoef_eq k] using hfin)

/-- **Сведение для `r·θ`** (знак `-2x`, класс `erf`): если `r·e^{−x²}` имеет логарифмическую
форму, то уравнение Риша `y′ - 2x·y = r` имеет рациональное решение `y ∈ k(x)`. -/
theorem exp_neg_sq_rat_risch (r : RatFunc k)
    (hform : HasLogForm (algebraMap (RatFunc k) (Gauss k) r * θ k)) :
    ∃ y : RatFunc k, y′ + (-2 * RatFunc.X) * y = r := by
  classical
  obtain ⟨n, c, u, v, hc, h⟩ := hform
  have ht := θ_transcendental k
  set b : RatFunc k := -2 * RatFunc.X with hb_def
  have hb : ∀ j : ℕ, 0 < j → ∀ z : RatFunc k, z′ = j * b * z → z = 0 :=
    fun j hj z hz => ratFunc_no_exp_solution_gen (thetaCoef k) (thetaCoef_deg k) (j : ℤ)
      (by omega) z (by rw [hb_def, ← thetaCoef_eq k] at hz; simpa using hz)
  have hθloc : ∀ p : (RatFunc k)[X], ∀ (_ : p.Monic) (hi : Irreducible p), p ≠ X →
      θ k ∈ locRing ht hi.prime := fun p _ hi _ => by
    have := aeval_mem_locRing ht hi.prime X
    rwa [aeval_X] at this
  have ha : ∀ p : (RatFunc k)[X], ∀ (_ : p.Monic) (hi : Irreducible p), p ≠ X →
      algebraMap (RatFunc k) (Gauss k) r * θ k ∈ locRing ht hi.prime := by
    intro p hp hi hX
    exact mul_mem (algebraMap_mem_locRing ht hi.prime r) (hθloc p hp hi hX)
  obtain ⟨γ, e, δ, P, m, hγ, hδ, hvP, h'⟩ := exp_reduce ht (deriv_θ' k) (constants_mem_base k)
    hb c u v (algebraMap (RatFunc k) (Gauss k) r * θ k) hc (fun i => isRatIn k _)
    (isRatIn k v) ha h
  set β := ∑ i, γ i * logDeriv (e i) + δ * b with hβ
  have hvβ : v′ = algebraMap (RatFunc k) (Gauss k) r * θ k - algebraMap (RatFunc k) (Gauss k) β := by
    rw [hβ, map_add, map_sum, hb_def]
    conv_rhs => rw [h']
    ring
  have hid := exp_deriv_identity ht (deriv_θ' k) P m
  rw [← hvP, hvβ] at hid
  have hpoly : C r * X ^ (m + 1) - C β * X ^ m + C (m * b) * P = implicitDeriv (C b * X) P := by
    apply aeval_inj_of_transcendental ht
    rw [← hid]
    simp only [map_add, map_sub, map_mul, map_pow, aeval_X, aeval_C, map_natCast, hb_def]
    ring
  have hck := congrArg (fun q => q.coeff (m + 1)) hpoly
  simp only [coeff_add, coeff_sub, coeff_C_mul, coeff_X_pow, coeff_implicitDeriv_CX, ite_true,
    show m + 1 ≠ m from by omega, ite_false] at hck
  refine ⟨P.coeff (m + 1), ?_⟩
  push_cast at hck
  linear_combination -hck

/-- **Неэлементарность `r·e^{−x²}`** при отсутствии рационального решения уравнения Риша. -/
theorem exp_neg_sq_rat_not_elementary (r : RatFunc k)
    (hrisch : ¬ ∃ y : RatFunc k, y′ + (-2 * RatFunc.X) * y = r)
    (K : Type*) [Field K] [Differential K] [Algebra (Gauss k) K] [DifferentialAlgebra (Gauss k) K]
    [Differential.ContainConstants (Gauss k) K] (hK : IsElementary (Gauss k) K) :
    ¬ ∃ y : K, y′ = algebraMap (Gauss k) K (algebraMap (RatFunc k) (Gauss k) r * θ k) := by
  rintro ⟨y, hy⟩
  exact hrisch (exp_neg_sq_rat_risch k r (liouville_primitive hK _ y hy))

/-- **Общий вид сертификата для `erf`**: у `A·e^{−x²}/(x−a)` (`A ≠ 0`) нет элементарной
первообразной (простой полюс в `x = a`). -/
theorem exp_neg_sq_simple_pole_not_elementary (A : k) (hA : A ≠ 0) (a : k)
    (K : Type*) [Field K] [Differential K] [Algebra (Gauss k) K] [DifferentialAlgebra (Gauss k) K]
    [Differential.ContainConstants (Gauss k) K] (hK : IsElementary (Gauss k) K) :
    ¬ ∃ y : K, y′ = algebraMap (Gauss k) K
      (algebraMap (RatFunc k) (Gauss k)
        (algebraMap k[X] (RatFunc k) (C A) *
          (algebraMap k[X] (RatFunc k) (X - C a))⁻¹) * θ k) := by
  refine exp_neg_sq_rat_not_elementary k _ ?_ K hK
  rintro ⟨y, hy⟩
  exact ratFunc_no_simple_pole k (thetaCoef k) A hA a y
    (by simpa [← thetaCoef_eq k] using hy)

end Gauss

/-- **`e^{-x²}` has no elementary primitive** (Liouville; Spivak, Chapter 19). -/
theorem exp_neg_sq_not_elementary (k : Type*) [Field k] [CharZero k] (K : Type*) [Field K]
    [Differential K] [Algebra (Gauss k) K] [DifferentialAlgebra (Gauss k) K]
    [Differential.ContainConstants (Gauss k) K] (hK : IsElementary (Gauss k) K) :
    ¬ ∃ y : K, y′ = algebraMap (Gauss k) K (Gauss.θ k) := by
  rintro ⟨y, hy⟩
  exact Gauss.θ_not_hasLogForm k (liouville_primitive hK _ y hy)

end Spivak.ExpNegSq
